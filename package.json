{
  "name": "assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck:scripts": "tsc --project tsconfig.json --pretty false",
    "test:scripts": "bun test --max-concurrency=1 ./.claude/scripts/*.test.ts",
    "test:scripts:kuzu": "WARDROBE_RUN_KUZU_TESTS=1 bun test --max-concurrency=1 ./.claude/scripts/causal-kuzu.test.ts ./.claude/scripts/causal-runtime.test.ts",
    "persona:dashboard": "bun .claude/scripts/persona-dashboard.ts",
    "persona:sync": "bun .claude/scripts/persona-data.ts",
    "persona:causal-sync": "bun .claude/scripts/causal-kuzu.ts",
    "persona:causal-inspect": "bun .claude/scripts/causal-kuzu-inspect.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "kuzu": "^0.11.3",
    "linkedom": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "bun-types": "^1.3.11",
    "typescript": "^6.0.2"
  }
}
