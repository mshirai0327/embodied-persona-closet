# Tapo Camera Configuration
# Supports Tapo C200 / C210 / C220 and similar ONVIF-capable PTZ models.
# Use the camera account from the Tapo app, not your TP-Link cloud account.

# Your camera IP address on the local network
TAPO_CAMERA_HOST=192.168.11.xxx

# Camera account credentials
# (Tapo App > Camera Settings > Advanced Settings > Camera Account)
TAPO_USERNAME=your-camera-username
TAPO_PASSWORD=your-camera-password

# Optional: ONVIF port (default: 2020 for Tapo cameras)
# TAPO_ONVIF_PORT=2020

# Optional: Mount mode - "normal" (desk/shelf) or "ceiling" (inverted mount)
# In ceiling mode, pan/tilt axes are inverted and images are rotated 180 degrees.
# TAPO_MOUNT_MODE=normal

# Optional: RTSP stream URL (auto-detected if not set)
# TAPO_STREAM_URL=rtsp://192.168.11.xxx:554/stream1

# Optional: Audio source
# MIC_SOURCE=camera

# Optional: Capture size override
# CAPTURE_MAX_WIDTH=1920
# CAPTURE_MAX_HEIGHT=1080

# ============================================
# Stereo Vision (Optional - Second Camera)
# ============================================
# Add a second camera for stereo vision (both eyes).
# If configured, see_right and see_both tools become available.

# Right camera IP address (required for stereo)
# TAPO_RIGHT_CAMERA_HOST=192.168.11.yyy

# Right camera ONVIF port (optional - uses left camera port if not set)
# TAPO_RIGHT_ONVIF_PORT=2020

# Right camera credentials (optional - uses left camera credentials if not set)
# TAPO_RIGHT_USERNAME=your-right-camera-username
# TAPO_RIGHT_PASSWORD=your-right-camera-password

# Right camera mount mode (optional - uses TAPO_MOUNT_MODE if not set)
# TAPO_RIGHT_MOUNT_MODE=normal
