# Configure at least one TTS engine.

# VOICEVOX (local HTTP API)
# Start the VOICEVOX engine first, then point tts-mcp at it.
VOICEVOX_URL=http://localhost:50021
VOICEVOX_SPEAKER=3

# ElevenLabs (optional)
# ELEVENLABS_API_KEY=your-api-key
# ELEVENLABS_VOICE_ID=uYp2UUDeS74htH10iY2e
# ELEVENLABS_MODEL_ID=eleven_v3
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Shared local playback options (useful on WSL)
# auto | paplay | elevenlabs | ffplay
TTS_PLAYBACK=auto
TTS_PLAY_AUDIO=true
TTS_SAVE_DIR=/tmp/tts-mcp
# Set PulseAudio sink id (e.g. 1) when using paplay/WSL
# ELEVENLABS_PULSE_SINK=
# Explicit PulseAudio server (WSLg default shown)
# ELEVENLABS_PULSE_SERVER=unix:/mnt/wslg/PulseServer

# Camera speaker output (optional)
# `TTS_CAMERA_BACKEND=auto` prefers direct Tapo backchannel when
# TAPO_CAMERA_HOST and TAPO_CLOUD_PASSWORD are set, otherwise falls back to go2rtc.
# Set `TTS_CAMERA_BACKEND=tapo` to force direct playback.
# Set `TTS_CAMERA_BACKEND=go2rtc` to keep using go2rtc.
TTS_CAMERA_BACKEND=auto
#
# Tapo camera IP address (or use GO2RTC_CAMERA_HOST for a tts-mcp-specific override)
TAPO_CAMERA_HOST=192.168.x.x
# GO2RTC_CAMERA_HOST=192.168.x.x
#
# RTSP/ONVIF and go2rtc use the local camera account set in the Tapo app
# under "Camera Account".
TAPO_USERNAME=your-camera-local-username
TAPO_PASSWORD=your-camera-local-password
# GO2RTC_CAMERA_USERNAME=your-camera-local-username
# GO2RTC_CAMERA_PASSWORD=your-camera-local-password
#
# Direct Tapo playback requires the TP-Link cloud account password.
# This is different from the local camera account above.
TAPO_CLOUD_PASSWORD=your-tplink-cloud-password
# GO2RTC_CAMERA_CLOUD_PASSWORD=your-tplink-cloud-password
#
# Advanced go2rtc options (only needed when TTS_CAMERA_BACKEND=go2rtc
# or when auto falls back to go2rtc)
# GO2RTC_URL=http://localhost:1984     # use an existing go2rtc instance
# GO2RTC_BIN=/path/to/go2rtc           # custom binary path
# GO2RTC_CONFIG=/path/to/go2rtc.yaml   # custom config file
# GO2RTC_AUTO_START=true
# GO2RTC_STREAM=tapo_cam
# GO2RTC_FFMPEG=ffmpeg
