{
  "mcpServers": {
    "memory": {
      "command": "uv",
      "args": ["run", "--directory", ".claude/mcps/memory-mcp", "memory-mcp"],
      "env": {
        "CLAUDE_PROJECT_DIR": "${PWD}"
      }
    },
    "tts": {
      "command": "uv",
      "args": ["run", "--directory", ".claude/mcps/tts-mcp", "tts-mcp"],
      "env": {
        "CLAUDE_PROJECT_DIR": "${PWD}",
        "MCP_BEHAVIOR_TOML": "${PWD}/mcpBehavior.toml",
        "VOICEVOX_URL": "http://localhost:50021",
        "VOICEVOX_SPEAKER": "10",
        "TTS_PLAYBACK": "auto",
        "TTS_DEFAULT_ENGINE": "voicevox"
      }
    },
    "usb-webcam": {
      "command": "uv",
      "args": ["run", "--directory", ".claude/mcps/usb-webcam-mcp", "usb-webcam-mcp"],
      "env": {
        "CLAUDE_PROJECT_DIR": "${PWD}"
      }
    },
    "system-temperature": {
      "command": "uv",
      "args": ["run", "--directory", ".claude/mcps/system-temperature-mcp", "system-temperature-mcp"],
      "env": {
        "CLAUDE_PROJECT_DIR": "${PWD}"
      }
    },
    "hearing": {
      "command": "uv",
      "args": ["run", "--directory", ".claude/mcps/hearing", "hearing-mcp"],
      "env": {
        "CLAUDE_PROJECT_DIR": "${PWD}",
        "MCP_BEHAVIOR_TOML": "${PWD}/mcpBehavior.toml"
      }
    },
    "wifi-cam": {
      "command": "uv",
      "args": ["run", "--directory", ".claude/mcps/wifi-cam-mcp", "wifi-cam-mcp"],
      "env": {
        "CLAUDE_PROJECT_DIR": "${PWD}",
        "MCP_BEHAVIOR_TOML": "${PWD}/mcpBehavior.toml",
        "TAPO_MOUNT_MODE": "ceiling"
      }
    }
  }
}
